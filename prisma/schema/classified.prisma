model Classified {
  id         Int     @id @default(autoincrement())
  views Int @default(0)
  slug String @unique
  vrm String? 
  title String?
  description String?
  year Int
  odoReading Int @default(0) @map("odo_reading")
  doors Int @default(0)
  seats Int @default(5)
  price Int @default(0)
  makeId Int @map("make_id")
  make Make @relation(fields: [makeId], references: [id], onDelete: Cascade)
  modelId Int @map("model_id")
  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modelVariantId Int? @map("model_variant_id")
  modelVariant ModelVariant? @relation(fields: [modelVariantId], references: [id], onDelete: Cascade)
  ulezCompliance ULEZCompliance @default(EXEMPT) @map("ulez_compliance")
  transmission Transmission @default(MANUAL)
  colour Colour @default(BLACK)
  fuelType FuelType @default(PETROL)
  bodyType BodyType @default(SEDAN) @map("body_type")
  odoUnit OdoUnit @default(MILES) @map("odo_unit")
  currency CurrencyCode @default(GBP)
  status ClassifiedStatus @default(DRAFT)
  images Image[]
  customers Customer[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([makeId, modelId], name: "index_make_model")
  @@index([status], name: "index_status")
  @@index([price], name: "index_price")
  @@map("classifieds")
}

enum ClassifiedStatus {
  LIVE
  DRAFT
  SOLD
}
enum CurrencyCode {
  GBP
  USD
  EUR
  JPY
  AUD
  CAD
  CHF
  CNY
  SEK
  NZD
}

enum OdoUnit {
  MILES
  KILOMETERS
}
enum BodyType {
  SEDAN
  HATCHBACK
  SUV
  COUPE
  CONVERTIBLE
  WAGON
  VAN
  PICKUP
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum Colour {
  BLACK
  WHITE
  GREY
  SILVER
  RED
  BLUE
  GREEN
  YELLOW
  ORANGE
  PURPLE
  BROWN
  GOLD
}

enum ULEZCompliance {
  EXEMPT
  NON_EXEMPT
}

enum Transmission {
  MANUAL
  AUTOMATIC
}